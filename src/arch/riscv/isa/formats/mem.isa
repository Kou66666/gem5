def template MatrixStoreAInitiateAcc {{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        %(memacc_code)s;


        DPRINTF(RiscvMisc, "MatrixStoreA: EA = %#x, Rs1 = %#x Insn: %#x (index: %#d) \n",
        EA, xc->getRegOperand(this, 1), machInst, (machInst >> 15) & 0x1F);

        const size_t matrix_size = tmsize.m * tmsize.k;
        const std::vector<bool> byte_enable(matrix_size, true);

        DPRINTF(RiscvMisc, "MatrixStoreA: Memory content before writeMem:\n");
        for (int i = 0; i < matrix_size; i++) {
            DPRINTF(RiscvMisc, "MatrixStoreA Mem[%d] = %d\n", i, ((uint8_t*)&Mem)[i]);
        }

        Fault fault = xc->writeMem((uint8_t*)&Mem, matrix_size, EA, memAccessFlags, nullptr, byte_enable);

        if (fault != NoFault)
            return fault;

        %(op_wb)s;

        return NoFault;
    }
}};


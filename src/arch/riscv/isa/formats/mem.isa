def template LoadExecute {{
    Fault
    %(class_name)s::execute(
        ExecContext *xc, trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        {
            Fault fault =
                readMemAtomicLE(xc, traceData, EA, Mem, memAccessFlags);
            if (fault != NoFault)
                return fault;
        }

        %(memacc_code)s;

        %(op_wb)s;

        return NoFault;
    }
}};

def template MatrixLoadAInitiateAcc {{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_src_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        DPRINTF(RiscvMisc, "MatrixLoadA InitiateAcc: EA = %#x, Rs1 = %#x Insn: %#x (index: %d) \n",
        EA, xc->getRegOperand(this, 1), machInst, (machInst >> 15) & 0x1F);

        TMSIZE tmsize = xc->readMiscReg(MISCREG_TMSIZE);
        const size_t matrix_size = tmsize.m * tmsize.k;
        const std::vector<bool> byte_enable(matrix_size, true);

        DPRINTF(RiscvMisc, "MatrixLoadA InitiateAcc: matrix_size = %#x, tmsize.m = %#x tmsize.n: %#x \n",
        matrix_size, tmsize.m, tmsize.n);

        Fault fault = initiateMemRead(xc, EA, matrix_size, memAccessFlags, byte_enable);

        DPRINTF(RiscvMisc, "MatrixLoadA InitiateAcc: initiateMemRead sent matrix_size: %#x \n",
        matrix_size);


        return fault;
    }
}};

def template MatrixLoadACompleteAcc {{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;
        TMSIZE tmsize = xc->readMiscReg(MISCREG_TMSIZE);

        DPRINTF(RiscvMisc, "MatrixLoadA completeAcc: tmsize = %#x, tmsize.m = %#x tmsize.n: %#x \n",
        tmsize, tmsize.m, tmsize.n);

        DPRINTF(RiscvMisc, "MatrixLoadA completeAcc: pkt_size: %#x \n",
        pkt->getSize());

        memcpy(Mem.data(), pkt->getPtr<uint8_t>(), pkt->getSize());

        DPRINTF(RiscvMisc, "memcpy done \n");

        %(memacc_code)s;
        %(op_wb)s;

        DPRINTF(RiscvMisc, "MatrixLoadA: Matrix Register Data:\n");
        for (int m = 0; m < tmsize.m; m++) {
            for (int n = 0; n < tmsize.k; n++) {
                DPRINTF(RiscvMisc, "tmd[%d][%d] = %d\n", m, n, tmd.asHSlice<int>(m)[n]);
            }
        }

        return NoFault;
    }
}};


def template CacheBlockBasedStoreExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        Addr cacheBlockSize = xc->tcBase()->getCpuPtr()->cacheLineSize();
        uint64_t numOffsetBits = floorLog2(cacheBlockSize);
        EA = (EA >> numOffsetBits) << numOffsetBits;

        {
            Fault fault =
                writeMemAtomic(xc, nullptr, EA, cacheBlockSize, memAccessFlags,
                    nullptr, std::vector<bool>(cacheBlockSize, true));
            if (fault != NoFault)
                return fault;
        }

        return NoFault;
    }
}};

def template CacheBlockBasedStoreInitiateAcc {{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        Addr cacheBlockSize = xc->tcBase()->getCpuPtr()->cacheLineSize();
        uint64_t numOffsetBits = floorLog2(cacheBlockSize);
        EA = (EA >> numOffsetBits) << numOffsetBits;

        {
            Fault fault =
                writeMemTiming(xc, nullptr, EA, cacheBlockSize, memAccessFlags,
                    nullptr, std::vector<bool>(cacheBlockSize, true));
            if (fault != NoFault)
                return fault;
        }

        return NoFault;
    }
}};

def template CacheBlockBasedStoreCompleteAcc {{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        return NoFault;
    }
}};

def template PrefetchDeclare {{
    /**
     * Static instruction class for "%(mnemonic)s".
     */
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        /// Constructor.
        %(class_name)s(ExtMachInst machInst);

        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          trace::InstRecord *) const override;
        std::string
        generateDisassembly(Addr pc,
                            const loader::SymbolTable *symtab) const override
        {
            std::stringstream ss;
            ss << mnemonic << ' ' <<
                offset << '(' << registerName(srcRegIdx(0)) << ')';
            return ss.str();
        }
    };
}};


def template PrefetchCompleteAcc {{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        return NoFault;
    }
}};

def format Load(memacc_code, ea_code={{EA = rvSext(Rs1 + offset);}},
        offset_code={{offset = sext<12>(IMM12);}},
        mem_flags=[], inst_flags=[]) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        LoadStoreBase(name, Name, offset_code, ea_code, memacc_code, mem_flags,
        inst_flags, 'Load', exec_template_base='Load')
}};

def format MatrixLoadA(memacc_code, ea_code={{EA = rvSext(Rs1);}},
        offset_code={{offset = sext<12>(IMM12);}},
        mem_flags=[], inst_flags=[]) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        LoadStoreBase(name, Name, offset_code, ea_code, memacc_code, mem_flags,
        inst_flags, 'Load', exec_template_base='MatrixLoadA')
}};

def format MatrixLoadB(memacc_code, ea_code={{EA = rvSext(Rs1);}},
        offset_code={{offset = sext<12>(IMM12);}},
        mem_flags=[], inst_flags=[]) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        LoadStoreBase(name, Name, offset_code, ea_code, memacc_code, mem_flags,
        inst_flags, 'Load', exec_template_base='MatrixLoadB')
}};


def format Store(memacc_code, ea_code={{EA = rvSext(Rs1 + offset);}},
        offset_code={{offset = sext<12>(IMM5 | (IMM7 << 5));}},
        mem_flags=[], inst_flags=[]) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        LoadStoreBase(name, Name, offset_code, ea_code, memacc_code, mem_flags,
        inst_flags, 'Store', exec_template_base='Store')
}};

def format MatrixStoreA(memacc_code, ea_code={{EA = rvSext(Rs1);}},
        offset_code={{offset = sext<12>(IMM5 | (IMM7 << 5));}},
        mem_flags=[], inst_flags=[]) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        LoadStoreBase(name, Name, offset_code, ea_code, memacc_code, mem_flags,
        inst_flags, 'Store', exec_template_base='MatrixStoreA')
}};

def format MatrixStoreB(memacc_code, ea_code={{EA = rvSext(Rs1);}},
        offset_code={{offset = sext<12>(IMM5 | (IMM7 << 5));}},
        mem_flags=[], inst_flags=[]) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        LoadStoreBase(name, Name, offset_code, ea_code, memacc_code, mem_flags,
        inst_flags, 'Store', exec_template_base='MatrixStoreB')
}};

def template MatrixStoreCInitiateAcc {{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        %(memacc_code)s;

        DPRINTF(RiscvMisc, "MatrixStoreC: EA = %#x, Rs1 = %#x Insn: %#x (index: %d) \n",
        EA, xc->getRegOperand(this, 1), machInst, (machInst >> 15) & 0x1F);

        // Get dimensions from matrix size register
        const size_t matrix_size = tmsize.m * tmsize.n;
        const std::vector<bool> byte_enable(matrix_size, true);
        
        // Extract each individual value from the matrix
        std::vector<uint8_t> byte_data(matrix_size);
        for (int m = 0; m < tmsize.m; m++) {
            for (int n = 0; n < tmsize.n; n++) {
                // Get the value directly from the matrix view
                int value = Mem.asHSlice<int>(m)[n];
                // Store it as a byte in our vector
                byte_data[m * tmsize.n + n] = static_cast<uint8_t>(value);
            }
        }
        
        DPRINTF(RiscvMisc, "MatrixStoreC: Data to write:\n");
        for (size_t i = 0; i < matrix_size; i++) {
            DPRINTF(RiscvMisc, "Data[%lu] = %d\n", static_cast<unsigned long>(i), byte_data[i]);
        }
        
        DPRINTF(RiscvMisc, "MatrixStoreC: Writing matrix data, size=%lu bytes\n", static_cast<unsigned long>(matrix_size));
        Fault fault = xc->writeMem(byte_data.data(), matrix_size, EA, memAccessFlags, nullptr, byte_enable);

        if (fault != NoFault)
            return fault;

        %(op_wb)s;

        return NoFault;
    }
}};

def template MatrixStoreCCompleteAcc {{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        return NoFault;
    }
}};

